<c74object name='ambitap.rotate~' category='audio,  ambisonics,  spatial,  mc'>

	<digest>Rotate a higher-order ambisonics bus by yaw/pitch/roll (Euler, Z-Y-X)</digest>
	<description>Rotate a higher-order ambisonics bus by yaw/pitch/roll (Euler, Z-Y-X). Order is a creation argument; input and output are one multichannel signal of (order+1)^2 channels. </description>


	<!--METADATA-->

	<metadatalist>
		<metadata name='author'>Timothy Place </metadata>
		<metadata name='tag'>audio</metadata>
		<metadata name='tag'>ambisonics</metadata>
		<metadata name='tag'>spatial</metadata>
		<metadata name='tag'>mc</metadata>
	</metadatalist>


	<!--ARGUMENTS-->

	<objarglist>

	</objarglist>


	<!--MESSAGES-->

	<methodlist>

	</methodlist>


	<!--ATTRIBUTES-->

	<attributelist>

		<attribute name='yaw' get='1' set='1' type='float64' size='1' >
			<digest>Rotation about +Z (up), radians</digest>
			<description>Rotation about +Z (up), radians. Applied first. </description>
		</attribute>

		<attribute name='pitch' get='1' set='1' type='float64' size='1' >
			<digest>Rotation about +Y (left), radians</digest>
			<description>Rotation about +Y (left), radians. Applied second. </description>
		</attribute>

		<attribute name='roll' get='1' set='1' type='float64' size='1' >
			<digest>Rotation about +X (front), radians</digest>
			<description>Rotation about +X (front), radians. Applied last. </description>
		</attribute>

	</attributelist>


